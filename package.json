{
  "name": "dsh-market-recommender",
  "version": "1.1.2",
  "description": "Recommends an existing market plugin before a new one is written: a Recommend tab in the Plugins page plus a recommend_plugin tool, searching this profile's configured indexes, the community dshmarket catalog, and the optional plugins built into this installation.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cailiann/dsh-market-recommender.git"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
